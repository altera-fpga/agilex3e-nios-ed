   &amp;lt;peripherals&amp;gt;
   	&amp;lt;peripheral&amp;gt;
   		&amp;lt;name&amp;gt;msgdma_prefetcher_csr&amp;lt;/name&amp;gt;
   		&amp;lt;version&amp;gt;1.0&amp;lt;/version&amp;gt;
   		&amp;lt;description&amp;gt;msgdma_prefetcher_csr&amp;lt;/description&amp;gt;
   		&amp;lt;baseAddress&amp;gt;0x0&amp;lt;/baseAddress&amp;gt; 
   		&amp;lt;addressBlock&amp;gt;
   			&amp;lt;offset&amp;gt;0x0&amp;lt;/offset&amp;gt;
   			&amp;lt;size&amp;gt;20&amp;lt;/size&amp;gt;
   			&amp;lt;usage&amp;gt;registers&amp;lt;/usage&amp;gt;
   		&amp;lt;/addressBlock&amp;gt;
   		&amp;lt;registers&amp;gt;	
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;prefetcher_control&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Control Register&amp;lt;/displayName&amp;gt;
   				&amp;lt;description&amp;gt;Control Register&amp;lt;/description&amp;gt;
   				&amp;lt;addressOffset&amp;gt;0x0&amp;lt;/addressOffset&amp;gt;
   				&amp;lt;size&amp;gt;32&amp;lt;/size&amp;gt;
   				&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   				&amp;lt;resetValue&amp;gt;0x00000000&amp;lt;/resetValue&amp;gt;
   				&amp;lt;resetMask&amp;gt;0xffffffff&amp;lt;/resetMask&amp;gt;
   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;run&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Software sets this bit to 1 to start the descriptor fetching operation which subsequently initiates DMA transaction.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;0&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   						&amp;lt;modifiedWriteValues&amp;gt;oneToSet&amp;lt;/modifiedWriteValues&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;desc_poll_en&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Descriptor polling enable bit.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;1&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;1&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reset_prefetcher&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Allows software to stop prefetcher core when it is in the middle of data transfer. When this bit is set to 1, prefetcher core begin its reset sequence.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;2&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;2&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   						&amp;lt;modifiedWriteValues&amp;gt;oneToSet&amp;lt;/modifiedWriteValues&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;global_interrupt_enable_mask&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Set this bit to allow interrupts to propagate to the interrupt sender port.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;3&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;3&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;park_mode&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Enables mSGDMA to repeatedly execute the same linked list over and over again.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;4&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;4&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;reserved&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Reserved&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;5&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-only&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   				&amp;lt;/fields&amp;gt;
   			&amp;lt;/register&amp;gt;
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;prefetcher_nxt_desc_ptr_low&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Next Descriptor Pointer Low Register&amp;lt;/displayName&amp;gt;
   				&amp;lt;description&amp;gt;Next Descriptor Pointer Low Register&amp;lt;/description&amp;gt;
   				&amp;lt;addressOffset&amp;gt;0x4&amp;lt;/addressOffset&amp;gt;
   				&amp;lt;size&amp;gt;32&amp;lt;/size&amp;gt;
   				&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   				&amp;lt;resetValue&amp;gt;0x00000000&amp;lt;/resetValue&amp;gt;
   				&amp;lt;resetMask&amp;gt;0xffffffff&amp;lt;/resetMask&amp;gt;
   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;nxt_desc_ptr_low&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Contains the address[31:0] of the next descriptor to process. The address of the descriptors must be aligned to the descriptor read/write data width boundary.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   				&amp;lt;/fields&amp;gt;
   			&amp;lt;/register&amp;gt;
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;prefetcher_nxt_desc_ptr_high&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Next Descriptor Pointer High Register&amp;lt;/displayName&amp;gt;
   				&amp;lt;description&amp;gt;Next Descriptor Pointer High Register&amp;lt;/description&amp;gt;
   				&amp;lt;addressOffset&amp;gt;0x8&amp;lt;/addressOffset&amp;gt;
   				&amp;lt;size&amp;gt;32&amp;lt;/size&amp;gt;
   				&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   				&amp;lt;resetValue&amp;gt;0x00000000&amp;lt;/resetValue&amp;gt;
   				&amp;lt;resetMask&amp;gt;0xffffffff&amp;lt;/resetMask&amp;gt;
   				&amp;lt;fields&amp;gt;
   					&amp;lt;field&amp;gt;
   						&amp;lt;name&amp;gt;nxt_desc_ptr_high&amp;lt;/name&amp;gt;
   						&amp;lt;description&amp;gt;Contains the address[63:32] of the next descriptor to process. The address of the descriptors must be aligned to the descriptor read/write data width boundary.&amp;lt;/description&amp;gt;
   						&amp;lt;lsb&amp;gt;0&amp;lt;/lsb&amp;gt;
   						&amp;lt;msb&amp;gt;31&amp;lt;/msb&amp;gt;
   						&amp;lt;access&amp;gt;read-write&amp;lt;/access&amp;gt;
   					&amp;lt;/field&amp;gt;
   				&amp;lt;/fields&amp;gt;
   			&amp;lt;/register&amp;gt;
   			&amp;lt;register&amp;gt;
   				&amp;lt;name&amp;gt;prefetcher_desc_poll_freq&amp;lt;/name&amp;gt;
   				&amp;lt;displayName&amp;gt;Descriptor Polling Frequency Register&amp;lt;/displayName&amp;gt;
